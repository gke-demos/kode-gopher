# verify-go-toolchain: go.mod's `toolchain` directive is the one answer
# to "which Go does kode-gopher build with". Checks that everything else
# agrees:
#   - go.mod has a toolchain directive at all (the `go` directive is the
#     compatibility floor, not what we ship);
#   - sandbox/Dockerfile's golang base image is that version. The sandbox
#     builds cmd/sandbox-server with the root go.mod, and it compiles the
#     users' snippets, so drift means a different compiler in the sandbox
#     than in CI, or a toolchain download at image build time;
#   - server/Dockerfile's builder is that version too;
#   - workflows take Go from go.mod (go-version-file), never a literal.
#
#   verify-go-toolchain            static checks above
#   verify-go-toolchain --running  also: the go on PATH is that toolchain

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

want="$(sed -n 's/^toolchain go\([0-9.]*\)$/\1/p' go.mod)"
if [[ -z "$want" ]]; then
  echo "FAIL: go.mod has no 'toolchain goX.Y.Z' directive" >&2
  exit 1
fi
failed=0

for f in sandbox/Dockerfile server/Dockerfile; do
  docker="$(sed -n 's/^FROM \(--platform=[^ ]* \)\{0,1\}golang:\([0-9.]*\)[-@].*/\2/p' "$f")"
  if [[ "$docker" != "$want" ]]; then
    echo "FAIL: $f uses golang:${docker:-?}, go.mod's toolchain is go${want}" >&2
    failed=1
  fi
done

if grep -rn 'go-version:' .github/workflows >&2; then
  echo "FAIL: workflows above pin a Go version; use 'go-version-file: go.mod'" >&2
  failed=1
fi

if [[ "${1:-}" == "--running" ]]; then
  got="$(go env GOVERSION)"
  if [[ "$got" != "go${want}" ]]; then
    echo "FAIL: go on PATH is ${got}, go.mod's toolchain is go${want}" >&2
    failed=1
  fi
fi

if ((failed)); then
  exit 1
fi
echo "go-toolchain: OK (go${want})"
